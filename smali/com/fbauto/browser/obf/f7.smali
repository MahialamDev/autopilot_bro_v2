ountry\') && !aria.includes(\'country\');\n    });\n\n    // STEP 0e: Handle \'Confirm your mobile number\' (WhatsApp vs SMS confirmation method)\n    var isConfirmMethodPage = pageText.includes(\'confirm your mobile number\') ||\n                              pageText.includes(\'choose how you want to confirm\') ||\n                              pageText.includes(\'send code via whatsapp\') ||\n                              pageText.includes(\'send code via sms\') ||\n                              pageText.includes(\'\u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8\');\n\n    if (isConfirmMethodPage) {\n      var phoneMatch = pageText.match(/\\+?\\d{9,16}/);\n      if (phoneMatch && phoneMatch[0]) {\n        var detectedPhone = phoneMatch[0].startsWith(\'+\') ? phoneMatch[0] : (\'+\' + phoneMatch[0]);\n        if (window.AndroidBridge && window.AndroidBridge.saveLastPhoneNumber) {\n          try { window.AndroidBridge.saveLastPhoneNumber(detectedPhone); } catch(e){}\n        }\n      }\n      var smsRadio = Array.from(document.querySelectorAll(\'[role=\"radio\"], input[type=\"radio\"], div, span, p\')).find(function(el) {\n        var t = (el.innerText || el.getAttribute(\'aria-label\') || \'\').toLowerCase();\n        return t.includes(\'send code via sms\') || t.includes(\'via sms\') || t.includes(\'\u098f\u09b8\u098f\u09ae\u098f\u09b8 \u098f\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7\') || (t.includes(\'sms\') && !t.includes(\'whatsapp\'));\n      });\n      if (smsRadio) {\n        var radioTarget = smsRadio.closest(\'[role=\"radio\"]\') || smsRadio;\n        var isChecked = radioTarget.getAttribute(\'aria-checked\') === \'true\' || (radioTarget.checked === true);\n        if (!isChecked && !stepState.smsOptionSelected) {\n          stepState.smsOptionSelected = true;\n          log(\'\ud83c\udfaf Selecting \"Send code via SMS\" option instead of WhatsApp...\');\n          clickEle