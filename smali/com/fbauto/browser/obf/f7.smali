        }\n        return;\n      }\n    }\n\n    // STEP 0b: Cookie Consent Banner / Page (\"Allow all cookies\" / \"Accept all\")\n    var isTermsPage = pageText.includes(\"terms and policies\") || pageText.includes(\"agree to facebook\") || pageText.includes(\"by tapping i agree\");\n    if (!isTermsPage && (pageText.includes(\'cookie\') || pageText.includes(\'cookies\') || pageText.includes(\'allow the use of cookies\') || pageText.includes(\'\u0444\u0430\u0439\u043b\u0456\u0432 cookie\') || pageText.includes(\'\u0444\u0430\u0439\u043b\u0438 cookie\') || pageText.includes(\'\u0434\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438\'))) {\n      var cookieConsentBtn = findVisibleButtonWithText([\n        \'Allow all cookies\', \'Allow all\', \'Allow essential and optional cookies\',\n        \'Accept all\', \'Accept all cookies\',\n        \'\u0414\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438 \u0432\u0441\u0456 \u0444\u0430\u0439\u043b\u0438 cookie\', \'\u0414\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438 \u0432\u0441\u0456\', \'\u041f\u0440\u0438\u0439\u043d\u044f\u0442\u0438 \u0432\u0441\u0456\', \'\u0414\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438 \u0444\u0430\u0439\u043b\u0438 cookie\', \'\u0414\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438\',\n        \'\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044c \u0432\u0441\u0435 cookie\', \'\u041f\u0440\u0438\u043d\u044f\u0442\u044c \u0432\u0441\u0435\',\n        \'\u09b8\u09ac \u0995\u09c1\u0995\u09bf \u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09a8 \u0995\u09b0\u09c1\u09a8\', \'\u09b8\u09ac \u0995\u09c1\u0995\u09bf\u099c \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09c1\u09a8\', \'\u09b8\u09ac \u0995\u09c1\u0995\u09bf \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09c1\u09a8\',\n        \'Permitir todas las cookies\', \'Autoriser tous les cookies\', \'Alle Cookies erlauben\', \'Accepter tout\'\n      ]);\n      if (!cookieConsentBtn) {\n        var allBtns = Array.from(document.querySelectorAll(\'button, div[role=\"button\"], a\')).filter(function(el) {\n          var r = el.getBoundingClientRect();\n          if (r.width === 0 || r.height === 0) return false;\n          var t = (el.innerText || el.textContent || \'\').trim().toLowerCase();\n          return t.includes(\'\u0434\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u0438 \u0432\u0441\u0456\') || t.includes(\'allow all\') || t.includes(\'accept all\');\n        });\n        if (allBtns.length > 0) cookieConsentBtn = allBtns[0];\n      }\n      if (cookieConsentBtn) {\n        if (now - lastActionTime >= 150) {\n          log(\'\ud83c\udf6a Cookie Consent detected -> Auto clicking \"\' + (cookieConsentBtn.innerText || \'Allow all cookies\') + \'\"...\');\n          clickElement(cookieConsentBtn);\n          lastActionTime = now;\n          lastStep = \'cookieConsent\';\n        }\n        return;\n      }\n    }\n\n    // STEP 0c: Meta Account Creation Error & 3-Retry Flow (\"We couldn\'t create your account\")\n    // Flow: 1st initial normal attempt -> if \"couldn\'t create\", wait 5s and retry up to 3 times (max 3 retries) -> if still failing, auto restart fresh\n    var isCreationError = pageText.indexOf(\"couldn\'t create\") !== -1 ||\n                          pageText.indexOf(\'could not create\') !== -1 ||\n                          pageText.indexOf(\'cannot create\') !== -1 ||\n                          pageText.indexOf(\"we couldn\'t create your account\") !== -1 ||\n                          pageText.indexOf(\'we could not create your account\') !== -1 ||\n                          (pageText.indexOf(\'create an account\') !== -1 && (pageText.indexOf(\'could not\') !== -1 || pageText.indexOf(\"couldn\'t\") !== -1 || pageText.indexOf(\'cannot\') !== -1)) ||\n                          pageText.indexOf(\'\u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u099b\u09bf \u09a8\u09be\') !== -1 ||\n                          pageText.indexOf(\'\u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09be \u09af\u09be\u099a\u09cd\u099b\u09c7 \u09a8\u09be\') !== -1 ||\n                          ((pageText.indexOf(\'something went wrong\') !== -1 || pageText.indexOf(\'an error occurred\') !== -1 || pageText.indexOf(\'\u0995\u09bf\u099b\u09c1 \u098f\u0995\u099f\u09be \u09ad\u09c1\u09b2 \u09b9\u09af\u09bc\u09c7\u099b\u09c7\') !== -1) &&\n                           (stepState.termsAgreed || pageText.indexOf(\'terms\') !== -1 || pageText.indexOf(\'agree\') !== -1 || pageText.indexOf(\'\u098f\u0995\u09ae\u09a4\') !== -1 || pageText.indexOf(\'policies\') !== -1));\n\n    if (isCreationError) {\n      if ((stepState.errorRetryCount || 0) < 3) {\n        var okDialogBtn = findVisibleButtonWithText([\'OK\', \'Ok\', \'\u09a0\u09bf\u0995 \u0986\u099b\u09c7\', \'Dismiss\', \'Close\', \'Try again\', \'\u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\']);\n        if (okDialogBtn && (now - lastActionTime >= 250)) {\n          stepState.errorRetryCount = (stepState.errorRetryCount || 0) + 1;\n          stepState.agreeDetectedTime = 0;\n          stepState.termsAgreed = false;\n          stepState.errorRetryWaitUntil = now + 6000;\n          stepState.lastCountLogTime = 0;\n          log(\'\u26a0\ufe0f Creation Error Detected! Auto-clicking OK to dismiss, will retry I agree in 6s (\' + stepState.errorRetryCount + \'/3)...\');\n          clickElement(okDialogBtn);\n          lastActionTime = now;\n          lastStep = \'creationErrorDismissed\';\n          return;\n        } else if (!okDialogBtn) {\n          if (!stepState.errorRetryWaitUntil) {\n            stepState.errorRetryCount = (stepState.errorRetryCount || 0) + 1;\n            stepState.agreeDetectedTime = 0;\n            stepState.termsAgreed = false;\n            stepState.errorRetryWaitUntil = now + 6000;\n            stepState.lastCountLogTime = 0;\n            log(\'\u26a0\ufe0f \"We couldn\\\'t create your account\" detected! Waiting 6s before retry (\' + stepState.errorRetryCount + \'/3)...\');\n          }\n          if (now < stepState.errorRetryWaitUntil) {\n            var secLeft = Math.ceil((stepState.errorRetryWaitUntil - now) / 1000);\n            if (!stepState.lastCountLogTime || (now - stepState.lastCountLogTime >= 1000)) {\n              stepState.lastCountLogTime = now;\n              log(\'\u23f3 Retrying \"I agree\" in \' + secLeft + \'s (Retry \' + stepState.errorRetryCount + \'/3)...\');\n            }\n            return;\n          }\n          stepState.errorRetryWaitUntil = 0;\n          stepState.agreeDetectedTime = 0;\n          stepState.termsAgreed = false;\n          lastActionTime = now;\n          log(\'\ud83d\udd04 6s wait elapsed! Retrying I agree now (\' + stepState.errorRetryCount + \'/3)...\');\n          return;\n        }\n        return;\n      } else {\n        log(\'\u274c Account creation failed after 3 retries (total 4 attempts)! Requesting fresh new start...\');\n        window._fbAutoStopped = true;\n        if (window._fbAutoActiveInterval) {\n          clearInterval(window._fbAutoActiveInterval);\n          window._fbAutoActiveInterval = null;\n        }\n        if (window.AndroidBridge && window.AndroidBridge.postMessage) {\n          try { window.AndroidBridge.postMessage(\'ERR_CREATION_BLOCKED\'); } catch(e){}\n        }\n        return;\n      }\n    }\n\n    // STEP 0d: Facebook / WebView \"Failed to load\" & network error auto-recovery\n    var isErrorText = pageText.indexOf(\"couldn\'t load page\") !== -1 || \n                      pageText.indexOf(\'failed to load\') !== -1 ||\n                      pageText.indexOf(\'load failed\') !== -1 ||\n                      pageText.indexOf(\'webpage not available\') !== -1 ||\n                      pageText.indexOf(\'could not be loaded\') !== -1 ||\n                      pageText.indexOf(\'error loading\') !== -1 ||\n                      pageText.indexOf(\'no internet connection\') !== -1 ||\n                      pageText.indexOf(\'connection timed out\') !== -1 ||\n                      pageText.indexOf(\'\u09b2\u09cb\u09a1 \u09b9\u09a4\u09c7 \u09ac\u09cd\u09af\u09b0\u09cd\u09a5\') !== -1 ||\n                      pageText.indexOf(\'\u0987\u09a8\u09cd\u099f\u09be\u09b0\u09a8\u09c7\u099f \u09b8\u0982\u09af\u09cb\u0997 \u09a8\u09c7\u0987\') !== -1;\n\n    var retryBtn = findVisibleButtonWithText([\n      \'Try again\', \'Try Again\', \'Tap to retry\', \'Retry\', \'Reload page\', \'Reload\',\n      \'\u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\', \'\u09aa\u09c1\u09a8\u09b0\u09be\u09af\u09bc \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\', \'\u09b0\u09bf\u09b2\u09cb\u09a1\'\n    ]);\n\n    if (retryBtn) {\n      if (now - lastActionTime >= 150) {\n        log(\'\ud83d\udd04 \"Failed to load\" error detected -> Auto-clicking \"\' + (retryBtn.innerText || \'Try again\') + \'\" & resuming...\');\n        clickElement(retryBtn);\n        lastActionTime = now;\n        lastStep = \'retryClicked\';\n      }\n      return;\n    } else if (isErrorText && (now - lastActionTime >= 1500)) {\n      log(\'\ud83d\udd04 \"Failed to load\" error page detected -> Navigating to fresh registration...\');\n      lastActionTime = now;\n      window.location.href = \"https://m.facebook.com/reg/?locale=en_US&_rdr=p&t=\" + Date.now();\n      return;\n    }\n\n    // STEP 1: Click \'Create new account\' / \'Get Started\' on registration landing page\n    var getStartedBtn = findVisibleButtonWithText([\n      \'Create new account\', \'Create New Account\', \'Create account\', \'Create Account\',\n      \'Get started\', \'Get Started\', \'\u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8\', \'Getting started\',\n      \'\u09a8\u09a4\u09c1\u09a8 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8\', \'\u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8\'\n    ]);\n    if (getStartedBtn) {\n      if (!stepState.getStarted || (now - lastActionTime >= 1200)) {\n        stepState.getStarted = true;\n        log(\'\ud83d\ude80 Clicking \"Create new account\"...\');\n        clickElement(getStartedBtn);\n        lastActionTime = now;\n        lastStep = \'getStarted\';\n      }\n      return;\n    }\n\n    // STEP 2: What\'s your name? (First Name & Surname)\n    var fnInput = allVisibleInputs.find(function(el) {\n      var n = (el.name || \'\').toLowerCase();\n      var aria = (el.getAttribute(\'aria-label\') || \'\').toLowerCase();\n      var p = (el.getAttribute(\'placeholder\') || \'\').toLowerCase();\n      var id = (el.id || \'\').toLowerCase();\n      return n === \'firstname\' || aria.includes(\'first\') || p.includes(\'first\') || id.includes(\'firstname\');\n    });\n    var lnInput = allVisibleInputs.find(function(el) {\n      var n = (el.name || \'\').toLowerCase();\n      var aria = (el.getAttribute(\'aria-label\') || \'\').toLowerCase();\n      var p = (el.getAttribute(\'placeholder\') || \'\').toLowerCase();\n      var id = (el.id || \'\').toLowerCase();\n      return n === \'lastname\' || aria.includes(\'last\') || aria.includes(\'surname\') || p.includes(\'last\') || p.includes(\'surname\') || id.includes(\'lastname\');\n    });\n    if (!fnInput || !lnInput) {\n      var visibleTexts = findInputs().filter(function(i){ return (i.type || \'text\').toLowerCase() === \'text\'; });\n      if (visibleTexts.length >= 2) {\n        fnInput = visibleTexts[0];\n        lnInput = visibleTexts[1];\n      }\n    }\n\n    if (fnInput && lnInput) {\n      var curFn = (fnInput.value || \'\').trim();\n      var curLn = (lnInput.value || \'\').trim();\n      var curFullName = (curFn + \' \' + curLn).trim();\n\n      var isNameRejected = pageText.includes(\'require everyone to use the name\') ||\n                           pageText.includes(\'what their friends call them\') ||\n                           pageText.includes(\'use the name they use in everyday life\') ||\n                           pageText.includes(\'use in everyday life\') ||\n                           pageText.includes(\'everyday life\') ||\n                           pageText.includes(\'please enter a valid name\') ||\n                           pageText.includes(\'enter a valid name\') ||\n                           pageText.includes(\'valid name\') ||\n                           pageText.includes(\'\u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09bf\u09a8\u09c7\u09b0 \u099c\u09c0\u09ac\u09a8\u09c7 \u09af\u09c7 \u09a8\u09be\u09ae \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7\u09a8\') ||\n                           pageText.includes(\'\u09ac\u09a8\u09cd\u09a7\u09c1\u09b0\u09be \u09a4\u09be\u09a6\u09c7\u09b0 \u09af\u09c7 \u09a8\u09be\u09ae\u09c7 \u09a1\u09be\u0995\u09c7\') ||\n                           Boolean(document.querySelector(\'input[aria-invalid=\"true\"]\')) ||\n                           Boolean(fnInput.getAttribute(\'aria-invalid\') === \'true\' || lnInput.getAttribute(\'aria-invalid\') === \'true\');\n\n      if (isNameRejected) {\n        if (!stepState.lastRejectedName || stepState.lastRejectedName !== curFullName) {\n          stepState.lastRejectedName = curFullName;\n          stepState.nameFilled = false;\n          log(\'\u26a0\ufe0f Name rejected by Facebook (\' + curFullName + \') -> Generating fresh replacement name...\');\n\n          var freshF = \'\';\n          var freshL = \'\';\n          var freshG = gender;\n\n          if (window.AndroidBridge && window.AndroidBridge.getFreshNameJson) {\n            try {\n              var fJson = window.AndroidBridge.getFreshNameJson();\n              var parsed = JSON.parse(fJson);\n              if (parsed && parsed.fName && parsed.lName) {\n                freshF = parsed.fName;\n                freshL = parsed.lName;\n                if (parsed.gender) freshG = parsed.gender;\n              }\n            } catch(e){}\n          }\n\n          if (!freshF || freshF === curFn) {\n            var modernMales = [\'Lucas\', \'Gabriel\', \'Matheus\', \'Felipe\', \'Rafael\', \'Gustavo\', \'Leonardo\', \'Thiago\', \'Bruno\', \'Rodrigo\', \'Guilherme\', \'Eduardo\', \'Vinicius\', \'Alexandre\', \'Diego\', \'Caio\', \'Daniel\', \'Marcos\', \'Andre\', \'Fabio\'];\n            var modernFemales = [\'Larissa\', \'Camila\', \'Beatriz\', \'Mariana\', \'Carolina\', \'Amanda\', \'Bruna\', \'Juliana\', \'Gabriela\', \'Fernanda\', \'Jessica\', \'Natalia\', \'Vanessa\', \'Bianca\', \'Patricia\', \'Renata\', \'Rafaela\', \'Luana\', \'Isabela\', \'Giovanna\'];\n            var modernSurnames = [\'Silva\', \'Santos\', \'Oliveira\', \'Souza\', \'Rodrigues\', \'Ferreira\', \'Alves\', \'Pereira\', \'Lima\', \'Gomes\', \'Costa\', \'Ribeiro\', \'Martins\', \'Carvalho\', \'Almeida\', \'Lopes\', \'Soares\', \'Fernandes\', \'Vieira\', \'Barbosa\'];\n            var isM = (gender.toLowerCase() === \'male\');\n            var pool = isM ? modernMales : modernFemales;\n            freshF = pool[Math.floor(Math.random() * pool.length)];\n            freshL = modernSurnames[Math.floor(Math.random() * modernSurnames.length)];\n          }\n\n          fName = freshF;\n          lName = freshL;\n          gender = freshG;\n          window._fbProfile.fName = freshF;\n          window._fbProfile.lName = freshL;\n          window._fbProfile.gender = freshG;\n\n          setNativeValue(fnInput, \'\');\n          setNativeValue(lnInput, \'\');\n          setNativeValue(fnInput, freshF);\n          setNativeValue(lnInput, freshL);\n          log(\'\u2705 Fresh replacement name applied: \' + freshF + \' \' + freshL);\n          stepState.nameFilled = true;\n          lastActionTime = Date.now();\n\n          setTimeout(function() {\n            var nBtn = Array.from(document.querySelectorAll(\'button, div[role=button], a, div, span\')).find(function(el) {\n              return isNextBtn(el);\n            });\n            if (nBtn) {\n              log(\'\u23e9 Clicking Next with fresh replacement name (\' + freshF + \' \' + freshL + \')...\');\n              clickElement(nBtn);\n              lastActionTime = Date.now();\n            }\n          }, 180);\n          return;\n        }\n      }\n\n      if ((curFn === fName && curLn === lName) || (curFn.length >= 2 && curLn.length >= 2 && stepState.nameFilled)) {\n        stepState.nameFilled = true;\n      } else if (!stepState.nameFilled && !stepState.isTyping) {\n        if (curFn.length >= 2 && curLn.length >= 2 && !isNameRejected) {\n          log(\'\u2705 Existing Name detected in form: \' + curFn + \' \' + curLn);\n          window._fbProfile.fName = curFn;\n          window._fbProfile.lName = curLn;\n          fName = curFn;\n          lName = curLn;\n          stepState.nameFilled = true;\n          lastActionTime = Date.now();\n        } else {\n          stepState.isTyping = false;\n          log(\'\u270d\ufe0f Filling Name: \' + fName + \' \' + lName + \'...\');\n          setNativeValue(fnInput, fName);\n          setNativeValue(lnInput, lName);\n          log(\'\u2705 Name typed: \' + fName + \' \' + lName + \' (\' + gender.toUpperCase() + \')\');\n          stepState.nameFilled = true;\n          lastActionTime = Date.now();\n        }\n      }\n      if (stepState.nameFilled && (now - lastActionTime >= 150)) {\n        var nextBtn = Array.from(document.querySelectorAll(\'button, div[role=button], a, div, span\')).find(function(el) {\n          return isNextBtn(el);\n        });\n        if (nextBtn) {\n          log(\'\u23e9 Clicking Next (Name)...\');\n          clickElement(nextBtn);\n          lastActionTime = now;\n          lastStep = \'nameNext\';\n          return;\n        }\n      }\n      return;\n    }\n\n    // STEP 2b: Handle \'Select your name\' / \'Did you mean:\' recommendation page\n    var isSelectNamePage = pageText.includes(\'select your name\') ||\n                           pageText.includes(\'did you mean\') ||\n                           pageText.includes(\'\u09a8\u09be\u09ae \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\') ||\n                           (pageText.includes(\'you typed\') && (pageText.includes(\'everyday life\') || pageText.includes(\'what their friends call them\'))) ||\n                           (pageText.includes(\'\u09aa\u09cd\u09b0\u09a4\u09bf\u09a6\u09bf\u09a8\u09c7\u09b0 \u099c\u09c0\u09ac\u09a8\u09c7\') && pageText.includes(\'\u099f\u09be\u0987\u09aa \u0995\u09b0\u09c7\u099b\u09c7\u09a8\'));\n\n    if (isSelectNamePage) {\n      var nameRadios = Array.from(document.querySelectorAll(\'input[type=\"radio\"], [role=\"radio\"], [aria-checked], [data-sigil*=\"radio\"], [data-sigil*=\"option\"]\'));\n      var isAnyRadioChecked = nameRadios.some(function(r) {\n        return r.checked === true || r.getAttribute(\'aria-checked\') === \'true\';\n      });\n\n      if (!isAnyRadioChecked && nameRadios.length > 0) {\n        var firstRadio = nameRadios[0];\n        log(\'\ud83c\udfaf Select your name page detected -> Selecting 1st name suggestion...\');\n        try {\n          var container = firstRadio.closest(\'label, div[role=\"radio\"], div[role=\"button\"]\') || firstRadio.parentElement;\n          var optionText = (container ? container.innerText : \'\') || firstRadio.value || \'\';\n          optionText = optionText.trim().split(\'\\n\')[0].trim();\n          if (optionText.length > 2 && !optionText.toLowerCase().includes(\'select\') && !optionText.toLowerCase().includes(\'next\')) {\n            var parts = optionText.split(/\\s+/);\n            if (parts.length >= 2) {\n              window._fbProfile.fName = parts[0];\n              window._fbProfile.lName = parts.slice(1).join(\' \');\n              fName = parts[0];\n              lName = parts.slice(1).join(\' \');\n              log(\'\ud83d\udcdd Selected Name updated to: \' + optionText);\n            }\n          }\n        } catch(e) {}\n\n        clickElement(firstRadio);\n        var pContainer = firstRadio.closest(\'label, div[role=\"radio\"], div[role=\"button\"]\');\n        if (pContainer && pContainer !== firstRadio) {\n          clickElement(pContainer);\n        }\n        lastActionTime = now;\n        return;\n      } else if (!isAnyRadioChecked && nameRadios.length === 0) {\n        var clickableRows = Array.from(document.querySelectorAll(\'label, div[role=\"button\"], div\')).filter(function(el) {\n          var t = (el.innerText || \'\').trim();\n          var isBtn = el.tagName === \'BUTTON\' || (el.getAttribute(\'role\') || \'\') === \'button\';\n          var isNext = t.toLowerCase() === \'next\' || t.toLowerCase().includes(\'use a different name\');\n          var isHeader = t.toLowerCase().includes(\'select your name\') || t.toLowerCase().includes(\'you typed\') || t.toLowerCase().includes(\'did you mean\');\n          return !isBtn && !isNext && !isHeader && t.length > 3 && t.length < 50 && (el.children.length <= 2);\n        });\n        if (clickableRows.length > 0) {\n          log(\'\ud83c\udfaf Clicking fallback suggested name card: \' + (clickableRows[0].innerText || \'\'));\n          clickElement(clickableRows[0]);\n          lastActionTime = now;\n          return;\n        }\n      }\n\n      var nextBtn = findVisibleButtonWithText([\'Next\', \'\u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0\', \'Continue\', \'\u099a\u09be\u09b2\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8\']);\n      if (nextBtn && (now - lastActionTime >= 150)) {\n        log(\'\u23e9 Select your name -> Clicking Next...\');\n        clickElement(nextBtn);\n        lastActionTime = now;\n        lastStep = \'selectNameNext\';\n        return;\n      }\n      return;\n    }\n\n    // STEP 4b: Age Confirmation Popup (e.g. \"OK\" / \"Set\" dialog)\n    var okBtn = findVisibleButtonWithText([\'OK\', \'Ok\', \'\u09a0\u09bf\u0995 \u0986\u