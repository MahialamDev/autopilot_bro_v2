    const-string v2, "(function() {\n  if (window._antiLeakApplied) return;\n  window._antiLeakApplied = true;\n  try {\n    // 1. WebRTC IP Leak Protection: strip ICE servers to prevent real IP discovery\n    if (window.RTCPeerConnection) {\n      var origPC = window.RTCPeerConnection;\n      window.RTCPeerConnection = function(config, constraints) {\n        if (config && config.iceServers) {\n          config.iceServers = [];\n        }\n        return new origPC(config, constraints);\n      };\n      window.RTCPeerConnection.prototype = origPC.prototype;\n    }\n  } catch(e) {}\n  try {\n    // 2. Hide automation flags & ensure standard Chrome mobile features\n    if (window.navigator) {\n      try {\n        Object.defineProperty(navigator, \'webdriver\', { get: () => false, configurable: true });\n      } catch(e) {}\n      try {\n        Object.defineProperty(navigator, \'plugins\', { get: () => [1, 2, 3, 4, 5], configurable: true });\n      } catch(e) {}\n    }\n    if (!window.chrome) {\n      window.chrome = { app: { isInstalled: false }, runtime: {}, loadTimes: function(){}, csi: function(){} };\n    }\n  } catch(e) {}\n})();\n"

