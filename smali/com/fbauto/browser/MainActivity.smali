    const-string v0, "\';\n    var result = { action: \'waiting\', debug: \'\' };\n\n    // 1. Check if already logged in via cookie\n    var cm = null;\n    try { cm = document.cookie ? document.cookie.match(/c_user=(\\d+)/) : null; } catch(e) {}\n    if (cm) { return JSON.stringify({ action: \'uid\', val: cm[1] }); }\n\n    // Helper: Trigger native click and DOM click\n    function triggerClick(el) {\n      if (!el) return false;\n      var target = el.closest(\'[role=\"button\"]\') || el;\n      if (target.scrollIntoView) {\n        try { target.scrollIntoView({ behavior: \'instant\', block: \'center\' }); } catch(e){}\n      }\n      var rect = target.getBoundingClientRect();\n      if (rect.width <= 0 || rect.height <= 0) {\n        rect = el.getBoundingClientRect();\n      }\n      var x = rect.left + rect.width / 2;\n      var y = rect.top + rect.height / 2;\n      if (rect.width > 0 && rect.height > 0 && x > 0 && y > 0) {\n        if (window.AndroidBridge && window.AndroidBridge.dispatchNativeClick) {\n          try { window.AndroidBridge.dispatchNativeClick(x, y, window.innerWidth, window.innerHeight); } catch(e){}\n        }\n      }\n      try { target.click(); } catch(e){}\n      try {\n        [\'pointerdown\', \'mousedown\', \'pointerup\', \'mouseup\', \'click\'].forEach(function(evt) {\n          target.dispatchEvent(new MouseEvent(evt, { bubbles: true, cancelable: true, view: window }));\n        });\n      } catch(e){}\n      return true;\n    }\n\n    var allBtns = Array.from(document.querySelectorAll(\'div[role=\"button\"], [role=\"button\"], button, input[type=\"submit\"], a, span\'));\n\n    // 2. Cookie consent - click \'Allow All Cookies\' if present\n    var cookieBtn = allBtns.find(function(el) {\n      var t = (el.innerText || el.value || el.getAttribute(\'aria-label\') || \'\').trim().toLowerCase();\n      return t.indexOf(\'allow all cookies\') !== -1 || t.indexOf(\'allow all\') !== -1 ||\n             t.indexOf(\'allow essential and optional cookies\') !== -1 ||\n             t.indexOf(\'accept all cookies\') !== -1 || t.indexOf(\'accept all\') !== -1 ||\n             t.indexOf(\'accept cookies\') !== -1 || t.indexOf(\'only allow essential cookies\') !== -1;\n    });\n    if (cookieBtn) {\n      triggerClick(cookieBtn);\n      return JSON.stringify({ action: \'cookie_consented\' });\n    }\n\n    // 3. Remove language sheet overlays if present\n    try {\n      var langOverlays = document.querySelectorAll(\'[data-sigil*=\"language\"]\');\n      langOverlays.forEach(function(el) {\n        var p = el.closest(\'div[data-sigil]\') || el.parentElement;\n        if (p && p.offsetHeight > 100) { p.style.display = \'none\'; }\n      });\n    } catch(e) {}\n\n    // 3b. Error check: \"Failed to load\" error page detection -> Auto-restart like Auto Create\n    var isErrorText = document.body && (\n      document.body.innerText.indexOf(\'Failed to load\') !== -1 ||\n      document.body.innerText.indexOf(\'Something went wrong\') !== -1 ||\n      document.body.innerText.indexOf(\'\u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\') !== -1 ||\n      document.body.innerText.indexOf(\'\u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09af\u09be\u09df\u09a8\u09bf\') !== -1\n    );\n    if (isErrorText) {\n      window._closeBtnClickedTime = 0;\n      window._stopBtnClickedTime = 0;\n      window._fbLoginSubmitted = false;\n      var retryBtn = allBtns.find(function(el) {\n        var t = (el.innerText || el.value || \'\').trim().toLowerCase();\n        return t === \'try again\' || t === \'\u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\' || t === \'reload\';\n      });\n      if (retryBtn) {\n        triggerClick(retryBtn);\n        return JSON.stringify({ action: \'retry_clicked\' });\n      }\n      return JSON.stringify({ action: \'failed_to_load\' });\n    }\n\n    var now = Date.now();\n    // 4. Check for \'Stop creating account\' prompt\n    var stopBtn = allBtns.find(function(el) {\n      var t = (el.innerText || el.textContent || \'\').trim().toLowerCase();\n      return t === \'stop creating account\' || t === \'stop creating\' || t === \'\u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a4\u09c8\u09b0\u09bf \u09ac\u09a8\u09cd\u09a7 \u0995\u09b0\u09c1\u09a8\';\n    });\n    if (stopBtn && (!window._stopBtnClickedTime || now - window._stopBtnClickedTime > 3000)) {\n      var sRect = stopBtn.getBoundingClientRect();\n      if (sRect.width > 10 && sRect.height > 10) {\n        window._stopBtnClickedTime = now;\n        triggerClick(stopBtn);\n        return JSON.stringify({ action: \'dismissed_stop_dialog\' });\n      }\n    }\n\n    // 5. Check for Cross / Close button on registration page (\u2715 button)\n    var closeBtn = document.querySelector(\'div[role=\"button\"][aria-label=\"Close\"], [aria-label=\"Close\"], [aria-label=\"close\"]\');\n    if (closeBtn && (!window._closeBtnClickedTime || now - window._closeBtnClickedTime > 3000) && !stopBtn) {\n      var cRect = closeBtn.getBoundingClientRect();\n      if (cRect.width > 10 && cRect.height > 10) {\n        window._closeBtnClickedTime = now;\n        triggerClick(closeBtn);\n        return JSON.stringify({ action: \'dismissed_reg_close\' });\n      }\n    }\n\n    // 5b. Check for \'Save login info\' / \'Not now\' prompt\n    var saveInfoBtn = allBtns.find(function(el) {\n      var t = (el.innerText || el.value || \'\').trim().toLowerCase();\n      return t === \'not now\' || t === \'save\' || t === \'ok\' || t === \'\u098f\u0996\u09a8 \u09a8\u09df\' || t === \'\u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09c1\u09a8\';\n    });\n    if (saveInfoBtn && (!window._saveInfoClickedTime || now - window._saveInfoClickedTime > 3000)) {\n      window._saveInfoClickedTime = now;\n      triggerClick(saveInfoBtn);\n      return JSON.stringify({ action: \'dismissed_save_info\' });\n    }\n\n    // 5c. Unified One-Tap / Continue button (when FB Lite or app remembered session)\n    var continueBtn = allBtns.find(function(el) {\n      var t = (el.innerText || el.value || el.getAttribute(\'aria-label\') || \'\').trim().toLowerCase();\n      var r = el.getBoundingClientRect();\n      return (t === \'continue\' || t.indexOf(\'continue as\') === 0 || t.indexOf(\'log in as\') === 0 || t === \'\u099a\u09be\u09b2\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8\' || t === \'\u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0\') && r.width > 25 && r.height > 10;\n    });\n    if (continueBtn && (!window._continueClickedTime || now - window._continueClickedTime > 3000)) {\n      window._continueClickedTime = now;\n      triggerClick(continueBtn);\n      return JSON.stringify({ action: \'prompt_clicked\', debug: \'clicked continue on unified login\' });\n    }\n\n    // 6. Find login form inputs using multiple robust selectors\n    var email = document.querySelector(\'input[aria-label*=\"Mobile\"], input[aria-label*=\"email\"], input[name=\"email\"], input[name=\"phone\"], #m_login_email, input[type=\"email\"], input[type=\"tel\"], input[autocomplete=\"username\"]\');\n    var pass  = document.querySelector(\'input[aria-label*=\"Password\"], input[name=\"pass\"], input[name=\"password\"], #m_login_password, input[type=\"password\"], input[autocomplete=\"current-password\"]\');\n\n    if (!email && !pass) {\n      return JSON.stringify({ action: \'waiting\', debug: \'waiting for login inputs\' });\n    }\n\n    // 7. Find visible login button\n    var loginBtn = null;\n    var allRoleBtns = Array.from(document.querySelectorAll(\'div[role=\"button\"], [role=\"button\"], button, input[type=\"submit\"]\'));\n    loginBtn = allRoleBtns.find(function(el) {\n      var t = (el.innerText || el.textContent || el.value || el.getAttribute(\'aria-label\') || \'\').trim().toLowerCase();\n      var r = el.getBoundingClientRect();\n      return (t === \'log in\' || t === \'login\' || t === \'\u09b2\u0997 \u0987\u09a8\' || t === \'sign in\') && r.width > 20 && r.height > 10;\n    });\n    if (!loginBtn) {\n      loginBtn = document.querySelector(\'div[role=\"button\"][aria-label=\"Log in\"]\') ||\n                document.querySelector(\'div[role=\"button\"][aria-label=\"log in\"]\') ||\n                document.querySelector(\'button[name=\"login\"]\') ||\n                document.querySelector(\'button[type=\"submit\"]\');\n    }\n\n    // 8. Helper: set input value using React 16+ value tracker & events\n    function setNativeValue(el, val) {\n      if (!el) return;\n      try {\n        var proto = window.HTMLInputElement ? window.HTMLInputElement.prototype : Object.getPrototypeOf(el);\n        var descriptor = Object.getOwnPropertyDescriptor(proto, \'value\');\n        if (descriptor && descriptor.set) {\n          descriptor.set.call(el, val);\n        } else {\n          el.value = val;\n        }\n      } catch(e) {\n        el.value = val;\n      }\n      try {\n        var tracker = el._valueTracker;\n        if (tracker) tracker.setValue(\'\');\n      } catch(e) {}\n      try {\n        el.dispatchEvent(new InputEvent(\'input\', { bubbles: true, inputType: \'insertText\', data: val }));\n      } catch(e) {}\n      try { el.dispatchEvent(new Event(\'input\', { bubbles: true })); } catch(e) {}\n      try { el.dispatchEvent(new Event(\'change\', { bubbles: true })); } catch(e) {}\n    }\n\n    // 9. Fill credentials cleanly\n    if (email && PHONE.length > 0 && email.value !== PHONE) {\n      email.focus();\n      setNativeValue(email, PHONE);\n    }\n    if (pass && PASS.length > 0 && pass.value !== PASS) {\n      pass.focus();\n      setNativeValue(pass, PASS);\n    }\n\n    try { if (document.activeElement) document.activeElement.blur(); } catch(e){}\n    try { if (email) email.blur(); } catch(e){}\n    try { if (pass) pass.blur(); } catch(e){}\n\n    var emailFilled = (!email) || (email && email.value && email.value.length > 0);\n    var passFilled  = (pass && pass.value && pass.value.length > 0);\n\n    // 10. Click login button ONLY IF both fields are filled (Auto-reclick every 1.2s if missed)\n    var nowTime = Date.now();\n    if (loginBtn && emailFilled && passFilled) {\n      if (!window._lastLoginClickTime || (nowTime - window._lastLoginClickTime >= 1200)) {\n        window._lastLoginClickTime = nowTime;\n        window._fbLoginSubmitCount = (window._fbLoginSubmitCount || 0) + 1;\n        triggerClick(loginBtn);\n        try {\n          var form = loginBtn.closest(\'form\') || (pass ? pass.form : null) || (email ? email.form : null);\n          if (form && typeof form.requestSubmit === \'function\') {\n            form.requestSubmit(loginBtn);\n          }\n        } catch(e){}\n        result.action = \'submitted\';\n        result.debug = \'click #\' + window._fbLoginSubmitCount + \' phone=\' + PHONE;\n        return JSON.stringify(result);\n      } else {\n        result.action = \'submit_waiting\';\n        result.debug = \'waiting after click #\' + (window._fbLoginSubmitCount || 1);\n        return JSON.stringify(result);\n      }\n    }\n\n    if (emailFilled && passFilled) {\n      result.action = \'filled\';\n      return JSON.stringify(result);\n    }\n\n    return JSON.stringify(result);\n  } catch(err) {\n    return JSON.stringify({ action: \'error\', debug: err.message });\n  }\n})()"

